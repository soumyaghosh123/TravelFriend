# Provider selection per mode (comma-separated ids). Only "mock" exists in Milestone 1.
TRAIN_PROVIDERS=mock      # later: a licensed rail-data provider
BUS_PROVIDERS=mock        # later: redbus
FLIGHT_PROVIDERS=mock     # later: consolidator / metasearch affiliate
HOTEL_PROVIDERS=mock      # later: booking,agoda,expedia,makemytrip
CALENDAR_PROVIDERS=mock   # festivals, holidays, seasons
WEATHER_PROVIDERS=mock    # climate. "openmeteo" = real monthly weather (no key; free tier is non-commercial only, paid plan before a commercial launch)
ATTRACTION_PROVIDERS=mock # sights, hours, fees (licensed content source later)
LOCAL_TRANSPORT_PROVIDERS=mock # cabs, autos, buses, ferries; fares are estimates
CONTENT_PROVIDERS=mock   # dishes, restaurants, shops, do's & don'ts (curated database later)
RESTAURANT_PROVIDERS=mock # "osm" = real eateries from OpenStreetMap (Overpass, free, no key; attribution "© OpenStreetMap contributors" required; cached 24 h)
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Local infrastructure (docker compose up -d). Dev-only credentials; change them anywhere shared.
POSTGRES_USER=tripsaver
POSTGRES_PASSWORD=tripsaver
POSTGRES_DB=tripsaver
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql://tripsaver:tripsaver@localhost:5432/tripsaver?schema=public
REDIS_URL=redis://localhost:6379
# Price alerts run inside the API every day at 07:00 India time (BullMQ on this Redis) when REDIS_URL is set.
# In development, POST /api/dev/alerts/run checks them now; emails go to the API log unless SMTP_URL is set.

# Apps
API_PORT=4000
# CORS: the only origin allowed to call the API
WEB_ORIGIN=http://localhost:3000
# Where the web app (server side and the /api proxy) reaches the API
API_URL=http://localhost:4000
# Per-provider call timeout for result sections (ms); a slow provider makes its section "temporarily unavailable"
PROVIDER_TIMEOUT_MS=4000

# Accounts (build step 11). Sign-in emails: any SMTP service, e.g. smtps://user:pass@smtp-relay.brevo.com:465
# Leave SMTP_URL empty in development: the sign-in link is printed to the API log instead.
SMTP_URL=
MAIL_FROM="TripSaver <no-reply@example.com>"
# "Sign in with Google": an OAuth client (Web application) from Google Cloud Console, with the redirect URI
# {WEB_ORIGIN}/api/auth/google/callback. Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
