{
  "name": "@tripsaver/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tripsaver/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20",
    "dotenv-cli": "^8.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.2"
  },
  "scripts": {
    "build": "prisma generate && tsc -p .",
    "typecheck": "prisma generate && tsc --noEmit -p .",
    "lint": "eslint src prisma/seed.ts",
    "test": "vitest run --passWithNoTests",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  }
}
