{
  "name": "@tripsaver/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc-watch -p tsconfig.build.json --onSuccess \"node --env-file-if-exists=../../.env dist/main.js\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.7.1",
    "@tripsaver/domain": "workspace:*",
    "@tripsaver/providers": "workspace:*",
    "ioredis": "^6.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/node": "^20",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "tsc-watch": "^7.2.1",
    "unplugin-swc": "^2.0.0"
  }
}
